# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 运行时产物
app/data/gradio_run.log
app/data/runs/
# theme 持久化 (用户本机选的主题, 每台机器不同; AGENTS.md 说明)
app/data/theme_settings.json
# 用户通过向导保存的输入布局 (label/tier/help 自定义, 每台机器不同)
app/data/input_layouts/
# probe 截图子目录 (per-dev 调试 e2e/new_presets/wc_repro 等, 不入库)
app/data/probe_*/
.examples_cache/
.output_cache/
smoke_output.mp4

# 系统
Thumbs.db
.DS_Store

# venv
.venv/
venv/
env/

# 调试截图 (per-dev / per-CI,不入库)
app/data/*.png
# 调试用临时目录 (dom_dump.py / dryrun.py / compare_*/ 等) - 纯 dev 残留
_frames/

# 上次成功参数 (运行时状态)
app/data/last_run/

# Codex 内部规划文件
.zcode/
notes/
# 调试 probe 脚本 (Playwright / node) - 单次调试用,不入库
_inspect_vp.py
_run_both.log.err
# sanity-check 临时产物 (跑一个 preset 验证 example 走通, 跟 release preview 资产同目录易混淆)
app/static/examples/*_run.*

# webui launch via Start-Process with -RedirectStandardOutput/-RedirectStandardError, log files
# get recreated on each launch by the latest .venv Python process. Add to .gitignore to avoid
# spurious diff churn.
webui.out.log
webui.err.log

# 启动脚本 / 调试重定向 的日志目录 (0 字节 placeholder 也别入库)
logs/

# Local debug/probe scripts (not committed)
_probe*.py
_debug*.js
_debug*.py
_ui_shots/
# 向导临时 workflow (parse 时存 token, save 时清)
app/data/wizard/
